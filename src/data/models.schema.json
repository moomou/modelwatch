{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelwatch.local/models.schema.json",
  "title": "ModelWatch AI Release Catalog",
  "description": "Source-verified release history of major AI model lines across frontier and open-weight labs.",
  "type": "object",
  "required": ["lastVerified", "companies", "lines"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "lastVerified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO YYYY-MM-DD date when the catalog was last verified against official sources."
    },
    "companies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "shortName", "country", "website", "accent", "summary"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "shortName": { "type": "string", "minLength": 1 },
          "country": { "type": "string", "minLength": 2 },
          "website": { "type": "string", "pattern": "^https://" },
          "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "summary": { "type": "string", "minLength": 10 }
        }
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "companyId", "name", "tierLabel", "category", "access", "lifecycle", "summary", "releases"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "companyId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 2 },
          "tierLabel": { "type": "string", "minLength": 2 },
          "category": {
            "type": "string",
            "enum": ["frontier", "workhorse", "fast", "coding", "multimodal"]
          },
          "access": {
            "type": "string",
            "enum": ["proprietary", "open-weights"]
          },
          "lifecycle": {
            "type": "string",
            "enum": ["active", "consolidated"]
          },
          "lifecycleNote": {
            "type": "string",
            "minLength": 5
          },
          "summary": {
            "type": "string",
            "minLength": 10
          },
          "aaUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "arenaUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "releases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["version", "releasedAt", "highlights", "sourceUrl"],
              "additionalProperties": false,
              "properties": {
                "version": { "type": "string", "minLength": 2 },
                "releasedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "highlights": { "type": "string", "minLength": 5 },
                "sourceUrl": { "type": "string", "pattern": "^https://" },
                "aaUrl": { "type": "string", "pattern": "^https://" },
                "arenaUrl": { "type": "string", "pattern": "^https://" }
              }
            }
          }
        }
      }
    }
  }
}
